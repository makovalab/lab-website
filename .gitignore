public/
resources/
.hugo_build.lock

# Local photo-processing workspace: source photos, virtualenvs and intermediate
# crops. Large (>1GB) and not part of the site. Only the finished portraits
# belong in the repo, under static/img/member/. Which original each was made
# from is recorded in scripts/portraits.toml, since the archive itself is not
# here to be looked at.
images/
.venv/

# Source photos dropped in for scripts/make-portraits. The finished portrait it
# writes to static/img/member/ is what gets committed, not the original.
photos/inbox/*
!photos/inbox/.gitkeep

# Python bytecode from scripts/portraits.py
__pycache__/
*.py[cod]

# Local Hugo install, if the release tarball is unpacked here for previewing.
# Note it also contains README.md and LICENSE, which will overwrite this repo's.
/hugo
/hugo_*.tar.gz
/LICENSE

# Node toolchain for the Tailwind engine (HugoBlox). Installed with `npm install`.
node_modules/

# Throwaway virtualenv for scripts/migrate/*.py (PyYAML only).
.venv-migrate/

# Bundler lockfile. Deliberately not committed: `bundler-cache: true` in the
# deploy workflow installs frozen, so a lockfile has to match the runner's
# bundler exactly. The one that was here came from a sandbox running Bundler 4 --
# it carried a CHECKSUMS section and spelled the platform x86_64-linux-gnu --
# and the runner's Bundler 2 rejected it with exit 16 before the build even
# started. Master never had a lockfile; CI resolves html-proofer fresh, which is
# what has always worked.
Gemfile.lock

# Bundler installs gems here when `bundle install` is run with a path, and Go
# turns on vendoring the moment it sees a vendor/ directory beside go.mod --
# then fails, because that directory holds gems and no modules.txt. It breaks
# the Hugo build locally exactly as it broke the deploy.
/vendor/
